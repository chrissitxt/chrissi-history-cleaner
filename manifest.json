{
    "manifest_version": 3,
    "name": "chrissi's History Cleaner",
    "version": "0.8.0",
    "description": "Pause your history, clear it on startup or on a timer",
    "permissions": [
        "history",
        "browsingData",
        "alarms",
        "storage"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "chrissi's History Cleaner",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    }
}
